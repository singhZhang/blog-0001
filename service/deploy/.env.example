# 复制为同目录下的 .env 后按实际环境修改：
#   cp .env.example .env
# .env 含站点实际配置，不要提交到仓库或随代码分发。

# 【必填】允许跨域访问 API 的前端来源，多个用逗号分隔。
# 前端与 API 同域（经反向代理）时填站点自身地址；
# 明确要放行任意来源时填 *（仅公开只读内容可接受）。
CORS_ALLOWED_ORIGINS=https://blog.example.com

# 使用的镜像。默认为本地构建的 blog-service:local；
# 走镜像仓库发布时改为仓库地址 + 标签，例如：
# BLOG_IMAGE=registry.example.com/blog/service:20261109-1
#BLOG_IMAGE=blog-service:local

# 宿主机监听地址与端口。默认只绑定回环地址，外部流量统一经反向代理进入；
# 需要直接对外暴露时改为 0.0.0.0:8080。
#BLOG_BIND=127.0.0.1:8080

# MySQL 连接。容器内访问宿主机 MySQL 时把 MYSQL_HOST 改成 host.docker.internal。
MYSQL_HOST=47.94.248.206
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=blog

# 后台 Bearer 令牌。留空会关闭全部管理接口。
ADMIN_TOKEN=change-me
